<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">

    <!-- Header Section -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:srcCompat="@drawable/naviga_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/dm_sans_bold"
        android:text="NAVIGA"
        android:textColor="@color/text_bold"
        android:textSize="21sp"
        app:layout_constraintStart_toEndOf="@id/imageView"
        app:layout_constraintTop_toTopOf="@id/imageView" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/dm_sans_medium"
        android:text="Ateneo de Zamboanga University"
        android:textColor="@color/text_subtitle"
        android:textSize="10sp"
        app:layout_constraintStart_toEndOf="@id/imageView"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:srcCompat="@drawable/profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Search Section -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/search_bar_background"
        app:iconifiedByDefault="false"
        app:queryBackground="@null"
        app:queryHint="Where do you want to go?"
        android:theme="@style/CustomSearchViewText"
        app:layout_constraintTop_toBottomOf="@id/textView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Filter Section -->
    <HorizontalScrollView
        android:id="@+id/filter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/searchView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/searchView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/dm_sans"
                android:text="All"
                android:textSize="12sp"
                app:backgroundTint="@color/main_blue"
                app:icon="@drawable/all_icon"
                app:rippleColor="#E0E5F5" />/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                app:backgroundTint="@color/white"
                android:textColor="@color/text_light"
                app:iconTint="@color/text_light"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1.12dp"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/dm_sans"
                android:text="Academic"
                app:icon="@drawable/academic_icon"
                app:rippleColor="#E0E5F5" />/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                app:backgroundTint="@color/white"
                android:textColor="@color/text_light"
                app:iconTint="@color/text_light"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1.12dp"
                android:textSize="12sp"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/dm_sans"
                android:text="Study"
                app:icon="@drawable/study_icon"
                app:rippleColor="#E0E5F5" />/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                app:backgroundTint="@color/white"
                android:textColor="@color/text_light"
                app:iconTint="@color/text_light"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1.12dp"
                android:textSize="12sp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/dm_sans"
                android:text="Food"
                app:icon="@drawable/food_icon"
                app:rippleColor="#E0E5F5" />/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Map Section -->
    <ImageButton
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/search_bar_background"
        app:layout_constraintTop_toBottomOf="@id/filter"
        app:layout_constraintBottom_toTopOf="@id/destinationCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Destination Section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/destinationCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="#DCE3F7"
        app:strokeWidth="1.12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/destination_circle"
                android:padding="8dp"
                android:tint="@color/main_blue"
                app:srcCompat="@drawable/study_icon"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Main Library"
                    android:fontFamily="@font/dm_sans_bold"
                    android:textColor="@color/text_bold"
                    android:textSize="15sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 min walk · Floor 1"
                    android:fontFamily="@font/dm_sans_medium"
                    android:textColor="@color/text_medium"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Go"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="@font/dm_sans"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/main_blue"
                app:icon="@drawable/destination_icon"
                app:iconPadding="6dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>